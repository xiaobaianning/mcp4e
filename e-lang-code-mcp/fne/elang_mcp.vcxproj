      <GenerateDebugInformation Condition="'$(Configuration)'=='Debug'">true</GenerateDebugInformation>
      <GenerateDebugInformation Condition="'$(Configuration)'=='Release'">false</GenerateDebugInformation>
      <ModuleDefinitionFile>elang_mcp.def</ModuleDefinitionFile>
      <AdditionalDependencies>user32.lib;advapi32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="src\bridge.cpp" />
    <ClCompile Include="src\ide_api.cpp" />
    <ClCompile Include="src\pipe_server.cpp" />
